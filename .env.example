# Optional Docker hosting only. Normal desktop launchers do not need this file.
# Copy to .env and set the video folder as seen by the Docker host.
# Example paths: /share/Videos on QNAP, /volume1/video on Synology,
# /Users/you/Movies on macOS, or C:/Users/you/Videos on Windows.
CORNFIELD_LIBRARY_PATH=/absolute/path/to/videos

# Local access by default. For access from other devices, set this to the
# server's LAN IP address (or 0.0.0.0 to listen on all host interfaces).
CORNFIELD_BIND_ADDRESS=127.0.0.1
CORNFIELD_PORT=4300

# Defaults to a Docker-managed local volume. Optional: an absolute directory
# on the server's LOCAL filesystem. Never use an SMB/NFS share for this data.
# A custom directory must be writable by container user UID/GID 1000:1000.
# CORNFIELD_DATA_PATH=/absolute/local/path/to/cornfield-data
